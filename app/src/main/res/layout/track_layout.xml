<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/track_view"
    android:layout_width="match_parent"
    android:layout_height="61dp"
    android:paddingStart="13dp"
    android:paddingEnd="12dp"
    android:theme="@style/Base.Theme.PlaylistMaker.Search.Screen">

    <ImageView
        android:id="@+id/album_image"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="@drawable/rounded_corner_2"
        android:contentDescription="@string/album_image"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@drawable/no_image_album" />

    <TextView
        android:id="@+id/track_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/ys_display_regular"
        android:text="@string/track_name"
        android:textColor="?attr/colorPrimary"
        android:textFontWeight="400"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@+id/forward_icon"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/album_image"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/forward_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/arrow_forward"
        app:tint="?attr/colorSecondary" />

    <TextView
        android:id="@+id/artist_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/ys_display_regular"
        android:text="@string/artist_name"
        android:textColor="?attr/colorSecondary"
        android:textFontWeight="400"
        android:textSize="11sp"
        app:layout_constraintStart_toEndOf="@+id/album_image"
        app:layout_constraintTop_toBottomOf="@+id/track_name" />

    <TextView
        android:id="@+id/track_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="@font/ys_display_regular"
        android:text="@string/base_time"
        android:textColor="?attr/colorSecondary"
        android:textFontWeight="400"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@+id/forward_icon"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/dot"
        app:layout_constraintTop_toBottomOf="@+id/track_name" />

    <ImageView
        android:id="@+id/dot"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:scaleType="center"
        app:layout_constraintStart_toEndOf="@+id/artist_name"
        app:layout_constraintTop_toBottomOf="@+id/track_name"
        app:srcCompat="@drawable/dot_3"
        app:tint="?attr/colorSecondary" />


</androidx.constraintlayout.widget.ConstraintLayout>